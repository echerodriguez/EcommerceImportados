@model EcommerceImportados.Models.Pedido

<h1>Pago</h1>

<hr />

<h3>Pedido #@Model.Id</h3>

<p>
    <strong>Total:</strong>
    $@Model.Total
</p>

<form id="formPago">

    <input type="hidden"
           name="pedidoId"
           value="@Model.Id" />

    <div>
        <label>
            <input type="radio"
                   name="metodoPago"
                   value="Debito"
                   checked />

            Tarjeta Débito
        </label>

        <label>
            <input type="radio"
                   name="metodoPago"
                   value="Credito" />

            Tarjeta Crédito
        </label>
    </div>

    <br />

    <div>
        <label>Número de tarjeta</label>
        <br />

        <input type="text"
               id="numeroTarjeta"
               name="numeroTarjeta"
               maxlength="19"
               required />

        <img id="iconoTarjeta"
             src=""
             alt=""
             style="display: none; width: 45px; margin-left: 10px;" />
    </div>

    <br />

    <div>
        <label>Titular</label>
        <br />
        <input type="text"
               name="titular"
               required />
    </div>

    <br />

    <div>
        <label>Vencimiento</label>
        <br />
        <input type="text"
               maxlength="5"
               id="vencimiento"
               name="vencimiento"
               placeholder="MM/AA"
               required />
    </div>

    <br />

    <div>
        <label>CVV</label>
        <br />
        <input type="password"
               maxlength="3"
               id="cvv"
               name="cvv"
               placeholder="###"
               required />

        <button type="button"
                id="toggleCvv">
            👁
        </button>
    </div>

    <br />

    <button type="submit">
        Confirmar Pago
    </button>

</form>

@section Scripts {
    <script src="~/js/pagos.js"></script>
}