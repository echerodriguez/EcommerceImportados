@model EcommerceImportados.Models.Producto

@{
    ViewData["Title"] = "Editar Producto";
}

<div class="container my-5" style="max-width: 600px;">
    <div class="mb-4">
        <h1 class="fw-bold h3 text-dark">Editar Producto</h1>
        <p class="text-muted small">Modificá los detalles comerciales del artículo seleccionado.</p>
    </div>

    <div class="card border-0 shadow-sm rounded-0 p-4">
        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />

            <div class="mb-3">
                <label asp-for="Nombre" class="form-label small fw-bold text-uppercase text-muted">Nombre</label>
                <input asp-for="Nombre" class="form-control rounded-0" required />
                <span asp-validation-for="Nombre" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Descripcion" class="form-label small fw-bold text-uppercase text-muted">Descripción</label>
                <textarea asp-for="Descripcion" class="form-control rounded-0" rows="3"></textarea>
                <span asp-validation-for="Descripcion" class="text-danger small"></span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="SKU" class="form-label small fw-bold text-uppercase text-muted">SKU</label>
                    <input asp-for="SKU" class="form-control rounded-0" required />
                    <span asp-validation-for="SKU" class="text-danger small"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="CategoriaId" class="form-label small fw-bold text-uppercase text-muted">Categoría</label>
                    <select asp-for="CategoriaId" class="form-select rounded-0" asp-items="ViewBag.CategoriaId" required></select>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Precio" class="form-label small fw-bold text-uppercase text-muted">Precio ($)</label>
                    <input asp-for="Precio" type="number" step="0.01" class="form-control rounded-0" required />
                    <span asp-validation-for="Precio" class="text-danger small"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Stock" class="form-label small fw-bold text-uppercase text-muted">Stock Disponible</label>
                    <input asp-for="Stock" type="number" class="form-control rounded-0" required />
                    <span asp-validation-for="Stock" class="text-danger small"></span>
                </div>
            </div>

            <div class="mb-4">
                <label asp-for="ImagenUrl" class="form-label small fw-bold text-uppercase text-muted">URL de la Imagen</label>
                <input asp-for="ImagenUrl" type="text" class="form-control rounded-0" />
                <span asp-validation-for="ImagenUrl" class="text-danger small"></span>
            </div>

            <div class="d-flex justify-content-end gap-2">
                <a asp-action="Admin" class="btn btn-light rounded-0 btn-sm px-3">Cancelar</a>
                <button type="submit" class="btn btn-dark rounded-0 btn-sm px-4 fw-bold">Guardar Cambios</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}