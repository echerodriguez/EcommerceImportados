@model IEnumerable<EcommerceImportados.Models.Producto>

@{
    ViewData["Title"] = "Admin Productos";
}

<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold h3 text-dark">Panel de Productos</h1>
            <p class="text-muted small">Administración de stock, precios y catálogos.</p>
        </div>
        <a asp-action="Create" class="btn btn-dark rounded-0 text-uppercase fw-bold px-4 btn-sm">Nuevo Producto</a>
    </div>

    <div class="card border-0 shadow-sm rounded-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr class="text-uppercase text-muted small" style="font-size: 0.75rem; letter-spacing: 0.05em;">
                        <th class="ps-4">Imagen</th>
                        <th>Producto</th>
                        <th>SKU</th>
                        <th>Categoría</th>
                        <th>Precio</th>
                        <th>Stock</th>
                        <th class="text-end pe-4">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <img src="@item.ImagenUrl" alt="Thumb" class="object-fit-cover border" style="width: 50px; height: 50px;">
                                </td>
                                <td>
                                    <div class="fw-bold text-dark">@item.Nombre</div>
                                </td>
                                <td class="text-muted">@item.SKU</td>
                                <td><span class="badge bg-light text-dark border">@item.Categoria?.Nombre</span></td>
                                <td class="fw-bold text-dark">$@item.Precio.ToString("N2")</td>
                                <td>
                                    <span class="fw-semibold @(item.Stock == 0 ? "text-danger" : "text-muted")">@item.Stock un.</span>
                                </td>
                                <td class="text-end pe-4">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary rounded-0 me-1">Editar</a>
                                    <button class="btn btn-sm btn-outline-danger rounded-0" data-bs-toggle="modal" data-bs-target="#deleteModal-@item.Id">Eliminar</button>
                                </td>
                            </tr>

                            <div class="modal fade" id="deleteModal-@item.Id" tabindex="-1">
                                <div class="modal-dialog modal-dialog-centered">
                                    <div class="modal-content rounded-0 border-0 shadow">
                                        <form asp-action="Delete" asp-route-id="@item.Id" method="post">
                                            @Html.AntiForgeryToken()
                                            <div class="modal-header border-0 pb-0">
                                                <h5 class="modal-title fw-bold text-danger">¿Eliminar Producto?</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                            </div>
                                            <div class="modal-body py-3">
                                                <p class="mb-0">¿Estás seguro de eliminar <strong>@item.Nombre</strong>?</p>
                                            </div>
                                            <div class="modal-footer border-0 pt-0">
                                                <button type="button" class="btn btn-sm btn-light rounded-0" data-bs-dismiss="modal">Cancelar</button>
                                                <button type="submit" class="btn btn-sm btn-danger rounded-0 px-3">Confirmar</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted small">No hay productos creados todavía.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>