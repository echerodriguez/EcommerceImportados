@{
    ViewData["Title"] = "Home Page";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Ecommerce Importados</title>
    <link rel="stylesheet"
          href="~/css/style.css">
</head>
<body>

    <header>
        <nav class="navbar">
            <h1>Ecommerce Importados</h1>

            <ul>
                <li><a href="#">Inicio</a></li>
                <li><a href="#">Productos</a></li>
                <li><a href="#">Carrito 🛒</a></li>
                <li><a href="#">Login</a></li>
            </ul>
        </nav>
    </header>

    <section class="hero">
        <h2>Bienvenido a nuestra tienda</h2>
        <p>Los mejores productos importados al mejor precio.</p>
        <a href="#" class="btn">Ver Productos</a>
    </section>

    <section class="productos">
        <h2>Productos Destacados</h2>

        <div class="contenedor-productos">

            <div class="card">
                <img src="https://via.placeholder.com/250" alt="Producto">
                <h3>Mouse Gamer</h3>
                <p>$25.000</p>
                <button>Agregar al carrito</button>
            </div>

            <div class="card">
                <img src="https://via.placeholder.com/250" alt="Producto">
                <h3>Teclado Mecánico</h3>
                <p>$65.000</p>
                <button>Agregar al carrito</button>
            </div>

            <div class="card">
                <img src="https://via.placeholder.com/250" alt="Producto">
                <h3>Auriculares</h3>
                <p>$48.000</p>
                <button>Agregar al carrito</button>
            </div>

        </div>
    </section>

    <footer>
        <p>© 2026 Ecommerce Importados</p>
    </footer>

</body>
</html>