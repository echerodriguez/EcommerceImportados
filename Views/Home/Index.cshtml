@model IEnumerable<EcommerceImportados.Models.Producto>

@{
    ViewData["Title"] = "Welcome";
}

<section class="bg-light text-dark py-5 border-bottom">
    <div class="container my-5 py-4 text-center">
        <p class="text-uppercase text-muted fw-bold small mb-2" style="letter-spacing: 0.2em;">Del mundo a tu puerta</p>
        <h1 class="display-4 fw-bold text-uppercase tracking-tight mb-3" style="letter-spacing: -0.02em;">
            Global Imports
        </h1>
        <p class="lead text-muted mx-auto mb-4" style="max-width: 600px; font-size: 1.1rem;">
            Comprá productos internacionales de cualquier parte del mundo.
        </p>
        <div class="d-flex justify-content-center gap-3">
            <a href="/productos" class="btn btn-dark rounded-0 text-uppercase fw-bold px-4 py-2 small" style="letter-spacing: 0.05em;">
                Explorar Catálogo
            </a>
        </div>
    </div>
</section>
