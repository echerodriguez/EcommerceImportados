@model EcommerceImportados.ViewModels.RegisterViewModel

<h2>Registro</h2>

<form asp-action="Register" method="post">

    <input asp-for="Nombre" placeholder="Nombre" />
    <span asp-validation-for="Nombre"></span>

    <input asp-for="Apellido" placeholder="Apellido" />
    <span asp-validation-for="Apellido"></span>

    <input asp-for="Email" placeholder="Email" />
    <span asp-validation-for="Email"></span>

    <input asp-for="DNI" placeholder="DNI" />
    <span asp-validation-for="DNI"></span>

    <input asp-for="Password" type="password" placeholder="Contraseña" />
    <span asp-validation-for="Password"></span>

    <button type="submit">Registrarse</button>

</form>