@model EcommerceImportados.Models.Usuario

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-body p-4">
                    <h2 class="card-title text-center mb-4 fw-bold text-primary">Mi Cuenta</h2>

                    <div class="mb-3 border-bottom pb-2">
                        <span class="text-muted small fw-bold d-block text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.05em;">Nombre Completo</span>
                        <span class="fs-5 fw-semibold text-dark">@Model.Nombre @Model.Apellido</span>
                    </div>

                    <div class="mb-3 border-bottom pb-2">
                        <span class="text-muted small fw-bold d-block text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.05em;">Correo Electrónico</span>
                        <span class="fs-6 text-dark">@Model.Email</span>
                    </div>

                    <div class="mb-4 border-bottom pb-2">
                        <span class="text-muted small fw-bold d-block text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.05em;">DNI</span>
                        <span class="fs-6 text-dark">@Model.DNI</span>
                    </div>

                    <div class="d-grid gap-2 mt-4">
                        <a asp-controller="Account" asp-action="HistorialCompras" class="btn btn-primary btn-lg rounded-pill fw-bold shadow-sm">
                            Ver mis pedidos
                        </a>
                        <a asp-controller="Account" asp-action="Logout" class="btn btn-outline-danger btn-sm rounded-pill px-3 py-2 fw-semibold mt-2 shadow-sm">
                            Cerrar sesión
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>