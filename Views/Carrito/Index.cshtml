@model IEnumerable<EcommerceImportados.Models.DetalleCarrito>
<link rel="stylesheet" href="~/css/carrito.css" />

@{
    decimal subtotalGeneral = Model.Sum(x =>
        x.PrecioUnitario * x.Cantidad);
    decimal envio = 0; //subtotalGeneral > 0 ? 5000 : 0; HARDCODEADO EL ENVIO GRATIS
    decimal total = subtotalGeneral + envio;
}

<partial name="_CheckoutSteps" model='"Carrito"' />

<div class="carrito-container">

    <div class="carrito-productos">

        <h2>Mi Carrito</h2>

        @if (!Model.Any())
        {
            <p>Tu carrito está vacío.</p>
        }

        @foreach (var item in Model)
        {
            decimal itemSubtotal =
            item.PrecioUnitario * item.Cantidad;

            <div class="producto-card">

                <div class="producto-imagen">
                    <img src="@item.Producto.ImagenUrl"
                         alt="@item.Producto.Nombre" />
                </div>

                <div class="producto-info">

                    <h4>@item.Producto.Nombre</h4>

                    <p class="precio-unitario">
                        Precio unitario:
                        <strong>$@item.PrecioUnitario</strong>
                    </p>

                    <div class="cantidad-controls">

                        <form asp-action="DisminuirCantidad"
                              method="post">

                            <input type="hidden"
                                   name="productoId"
                                   value="@item.ProductoId" />

                            <button type="submit">
                                -
                            </button>

                        </form>

                        <span class="cantidad">
                            @item.Cantidad
                        </span>

                        <form asp-action="IncrementarCantidad"
                              method="post">

                            <input type="hidden"
                                   name="productoId"
                                   value="@item.ProductoId" />

                            <button type="submit">
                                +
                            </button>

                        </form>

                    </div>

                </div>

                <div class="producto-total">

                    <p>Subtotal</p>

                    <strong>
                        $@itemSubtotal
                    </strong>

                    <form asp-action="EliminarProducto"
                          method="post">

                        <input type="hidden"
                               name="productoId"
                               value="@item.ProductoId" />

                        <button class="btn-eliminar"
                                type="submit">
                            Eliminar
                        </button>

                    </form>

                </div>

            </div>
        }

    </div>

    <div class="resumen">

        <h3>Resumen</h3>

        <div class="linea">
            <span>Subtotal</span>
            <span>$@subtotalGeneral</span>
        </div>

        <div class="linea">
            <span>Envío</span>
            <span>Gratis!</span>
        </div>

        <hr />

        <div class="linea total">
            <span>Total</span>
            <span>$@total</span>
        </div>

        <form asp-action="FinalizarCompra"
              method="post">

            <button class="btn-comprar"
                    type="submit">
                Continuar compra
            </button>

        </form>

    </div>

</div>