@model IEnumerable<EcommerceImportados.Models.DetalleCarrito>

@{
    decimal total = 0;
}

<h1>Mi Carrito</h1>

<table class="table">
    <thead>
        <tr>
            <th>Imagen</th>
            <th>Producto</th>
            <th>Precio Unitario</th>
            <th>Cantidad</th>
            <th>Subtotal</th>
            <th>Acciones</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            decimal subtotal = item.PrecioUnitario * item.Cantidad;
            total += subtotal;

            <tr>
                <td>
                    <img src="@item.Producto.ImagenUrl"
                         alt="@item.Producto.Nombre"
                         width="100" />
                </td>

                <td>
                    @item.Producto.Nombre
                </td>

                <td>
                    $@item.PrecioUnitario
                </td>

                <td>

                    <form asp-action="DisminuirCantidad"
                          method="post"
                          style="display:inline;">

                        <input type="hidden"
                               name="productoId"
                               value="@item.ProductoId" />

                        <button type="submit">-</button>

                    </form>

                    <span style="margin:0 10px;">
                        @item.Cantidad
                    </span>

                    <form asp-action="IncrementarCantidad"
                          method="post"
                          style="display:inline;">

                        <input type="hidden"
                               name="productoId"
                               value="@item.ProductoId" />

                        <button type="submit">+</button>

                    </form>

                </td>

                <td>
                    $@subtotal
                </td>
                <td>
                    <form asp-action="EliminarProducto" method="post">
                        <input type="hidden"
                               name="productoId"
                               value="@item.ProductoId" />
                        <button type="submit">
                            Eliminar
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

<hr />

<h3>Total: $@total</h3>

<form asp-action="FinalizarCompra" method="post">
    <button type="submit">
        Finalizar Compra
    </button>
</form>